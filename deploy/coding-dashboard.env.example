# =============================================================================
# Coding Dashboard - Environment (systemd EnvironmentFile)
# Target path: /etc/coding-dashboard/coding-dashboard.env  (chmod 640, root:<user>)
# The installer generates this file; this is for reference.
# =============================================================================

# --- Security ---
# Long random secret, e.g.: openssl rand -hex 32
CD_SECRET_KEY=REPLACE_WITH_RANDOM_SECRET
CD_ADMIN_USERNAME=admin
# Auth (login + bearer token) is OFF by default as long as no password hash is
# set -- intended for deployments behind an authenticating proxy
# (e.g. Cloudflare Tunnel / Access). Then no login screen appears.
# To force a login: enter a pbkdf2 hash via `python -m app.cli hash-password`
# (this enables auth automatically).
CD_ADMIN_PASSWORD_HASH=
# Optional override: true forces auth (even without a hash -> login impossible
# until a hash is set), false disables it even when a hash is set.
# Empty = automatic (on as soon as CD_ADMIN_PASSWORD_HASH is set).
CD_REQUIRE_AUTH=

# --- GitHub ---
# Personal access token with 'repo' scope (fine-grained: Contents+Administration
# read/write for the target repos). For "delete repo" also delete_repo.
CD_GITHUB_TOKEN=
# Optional: org/user under which new repos are created. Empty = authenticated user.
CD_GITHUB_OWNER=

# --- Storage ---
CD_DATA_DIR=/var/lib/coding-dashboard

# --- Git identity for automatic commits ---
CD_GIT_AUTHOR_NAME=Coding Dashboard
CD_GIT_AUTHOR_EMAIL=coding-dashboard@localhost
CD_DEFAULT_BRANCH=main

# --- Files / Delivery ---
CD_AGENTS_CONFIG_PATH=/etc/coding-dashboard/config.yaml
CD_FRONTEND_DIST=/opt/coding-dashboard/frontend/dist

# --- CORS (Android app / other origins). "*" reflects the concrete origin,
#     so Cloudflare Access cookies work with credentials:include.
#     Stricter: CD_CORS_ORIGINS=https://localhost,https://dash.example.com
# ---
CD_CORS_ORIGINS=*

# --- Bind (nginx proxies to this) ---
CD_HOST=127.0.0.1
CD_PORT=8000

# --- Heartbeat (auto-poll GitHub issues + auto-spawn Claude Code) ---
# Main switch. Empty = off; the dashboard then runs NO automatic
# tick loops. The UI on /heartbeat can additionally flip the switch
# in the running process, but that only lasts until the next restart.
CD_HEARTBEAT_ENABLED=false
# How often the heartbeat wakes up and checks for new open issues.
# Minimum 5 minutes, to stay friendly to GitHub's rate limits.
CD_HEARTBEAT_INTERVAL_SECONDS=900
# Maximum simultaneously running project polls per tick.
CD_HEARTBEAT_MAX_CONCURRENT=2
# After a successful heartbeat task per project, wait this many minutes
# before starting a new one. Failed/Error/Cancelled tasks do NOT
# count toward the cooldown.
CD_HEARTBEAT_COOLDOWN_MINUTES=30
# Which agent is used for automatic fix tasks. Default "claude"
# (Claude Code). Other agent keys from config.yaml are also possible
# (e.g. "codex").
CD_HEARTBEAT_AGENT_KEY=claude
# On the first poll for a project: how many hours to look back.
# Later, last_issue_poll_at is used as the ``since`` value instead.
CD_HEARTBEAT_LOOKBACK_HOURS=24
# Optional label filter (comma-separated). Empty = all open issues.
# Example: "bug,good first issue" -> only issues with at least one
# of these labels are passed to agents.
CD_HEARTBEAT_LABELS=
# Opt-in filter: heartbeat should only fix issues assigned to a
# specific person (or a team account) on GitHub.
# Comma-separated list of GitHub logins (e.g. "alice,bot-account").
# Empty = automatically resolved from the token login (a single login).
# If neither ENV nor /user yields a login, the heartbeat does NOT tick
# (fail-closed: better to auto-fix nothing than issues the operator
# never asked for).
CD_HEARTBEAT_ASSIGNEE_LOGINS=
# Should the dashboard post a comment with commit hash + branch URL
# to the GitHub issue after a successful heartbeat fix?
# Default: true. Only works when CD_GITHUB_TOKEN is set and the issue
# has a token that can write to the repo.
CD_HEARTBEAT_COMMENT_ON_SUCCESS=true
# Should the dashboard auto-close the issue when the fix cleanly
# lands on the default branch (merge_state=merged + pushed=true)?
# Default: true. On merge conflict the issue stays open.
CD_HEARTBEAT_CLOSE_ON_MERGE=true

# --- Env profiles (operator-level: per-task / heartbeat ANTHROPIC_* injection) ---
# Create profiles under /settings/env-profiles (token is encrypted with CD_SECRET_KEY).
# Set here a default key that the heartbeat uses for ALL auto-spawned tasks,
# unless the project has an override. Empty = default (Anthropic).
CD_HEARTBEAT_ENV_PROFILE_KEY=

# --- Claude on host over SSH (per-task "Runner: host") ---
# Default: empty = Claude only runs in the container. Set CD_CLAUDE_SSH_USER
# (and optionally CD_CLAUDE_SSH_HOST/_PORT) so the dashboard creates an additional
# AgentSpec "claude-host" that drives the host-side `claude` over SSH
# (analogous to the existing Hermes SSH pattern). Then the start form
# exposes the "Runner: host" toggle per task.
# CD_CLAUDE_SSH_USER=
# CD_CLAUDE_SSH_HOST=host.docker.internal
# CD_CLAUDE_SSH_PORT=22
